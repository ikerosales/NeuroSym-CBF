# Copy this file to .env and fill in your own values.

# Required for scripts/01_download_releases.py and scripts/02_download_tags.py.
# Get one at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Optional -- override where runtime data/checkpoints/results are read from and written to.
# Defaults to ./data, ./models, ./results (relative to wherever a script is run from).
# DATA_DIR=./data
# MODELS_DIR=./models
# RESULTS_DIR=./results
